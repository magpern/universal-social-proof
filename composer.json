{
  "name": "magpern/universal-social-proof",
  "description": "Genuine, privacy-conscious WooCommerce purchase social-proof notifications.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "woocommerce/woocommerce-sniffs": "^1.0",
    "wp-coding-standards/wpcs": "^3.1",
    "wp-phpunit/wp-phpunit": "^7.0",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "UniversalSocialProof\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniversalSocialProof\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './tests/tmp/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test:unit": "phpunit -c phpunit.xml.dist",
    "test:integration": "phpunit -c phpunit-integration.xml.dist",
    "test:js": "node --test tests/js/usp-toaster.test.cjs",
    "ci": "bash scripts/ci/check.sh"
  },
  "config": {
    "platform": {
      "php": "8.1.99"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
