<?xml version="1.0"?>
<ruleset name="UniversalSocialProof">
	<description>Coding standards for Universal Social Proof.</description>

	<file>universal-social-proof.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/tmp/*</exclude-pattern>
	<exclude-pattern>*/tests/wp-tests-config.php</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files (src/Plugin.php) instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WooCommerce-Core">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="universal-social-proof"/>
			</property>
		</properties>
	</rule>

	<!--
		Frozen identity uses USP_ / usp_ (three letters). WPCS ignores prefixes
		shorter than 4 characters for matching; listing only usp/USP (and
		excluding ShortPrefixPassed) matches Universal Multicurrency’s approach
		so the sniff does not false-positive on USP_* while still documenting intent.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="usp"/>
				<element value="USP"/>
			</property>
		</properties>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Tests: self-describing methods; local file reads; WP test bootstraps. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary.Found">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WooCommerce.Commenting.CommentHooks">
		<exclude-pattern>*/tests/unit/bootstrap.php</exclude-pattern>
	</rule>
</ruleset>
